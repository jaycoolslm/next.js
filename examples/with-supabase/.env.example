# Local development values come from `npx supabase start` output.
# For a hosted/self-hosted Supabase project, use project settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only. Never expose to the browser. Used for invitation-gated account
# creation (public signup is disabled) and for writing contract snapshots.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
